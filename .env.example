# HUAWEI Health Data Extractor 環境設定

# ADB実行ファイルパス
ADB_PATH=C:\Users\toshi\AppData\Local\Android\Sdk\platform-tools\adb.exe

# 接続デバイスID
DEVICE_ID=SDEDU19A29007380

# 対象パッケージ
PACKAGE_NAME=com.huawei.health

# Google Gemini API キー (Google AI Studio で無料取得可能: https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Obsidian Vault 出力先（任意の Vault ディレクトリ。未設定時は data/obsidian が使用される）
OBSIDIAN_KENKOU_DIR=C:\Users\YOUR_USERNAME\Dropbox\共有\紙\MEMOda\KENKOU SYUTOKU
